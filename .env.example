# App-modus: 'demo' (alles lokaal, geen database) of 'production'
NEXT_PUBLIC_APP_MODE=demo

# Publieke URL van de app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alleen nodig in production-modus. Deze twee zijn geheim en horen daarom
# nooit een NEXT_PUBLIC_-prefix te krijgen: die waarden komen in de
# browserbundle terecht en zijn dan voor iedereen te lezen.
DATABASE_URL=postgres://logistiek:wachtwoord@localhost:5432/logistiek

# Genereer met: openssl rand -base64 32
SESSION_SECRET=
